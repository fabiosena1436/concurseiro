rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.generationCount == 0
        && request.resource.data.isUnlocked == false
        && request.resource.data.keys().hasOnly(['uid', 'name', 'socialName', 'phone', 'email', 'generationCount', 'isUnlocked'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'socialName', 'phone', 'email', 'generationCount', 'isUnlocked']);
      allow update: if (owner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'socialName', 'phone']))
        || (admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUnlocked']));
      allow delete: if admin();
    }

    match /results/{resultId} {
      allow create: if false;
      allow read, delete: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if false;
    }

    match /messages/{messageId} {
      allow create: if (owner(request.resource.data.userId)
          && request.resource.data.sender == 'user'
          && request.resource.data.isReadByAdmin == false
          && request.resource.data.isReadByUser == true)
        || (admin()
          && request.resource.data.sender == 'admin'
          && request.resource.data.isReadByAdmin == true
          && request.resource.data.isReadByUser == false);
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if (admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReadByAdmin']))
        || (signedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReadByUser']));
      allow delete: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /exams/{examId} {
      allow create: if false;
      allow read: if admin() || (signedIn() && resource.data.creatorId == request.auth.uid);
      allow delete: if false;
      allow update: if false;
    }
    match /papers/{paperId} {
      allow read: if resource.data.status == 'published' || admin();
      allow write: if false;
    }
    match /bankQuestions/{questionId} {
      allow read: if resource.data.status == 'published' || admin();
      allow write: if false;
      match /revisions/{revisionId} {
        allow read: if admin();
        allow write: if false;
      }
    }
    match /bankAttempts/{attemptId} {
      allow read: if admin();
      allow write: if false;
    }
  }
}
